<% layout("layouts/introboilerplate") %>
<body>
<section class="wl-hero">
  <div class="wl-card">

    <!-- Badge -->
    <div class="fade-up delay-1">
      <span class="wl-badge">
        <span class="wl-badge-dot"></span>
        First Full-Stack Project
      </span>
    </div>

    <!-- Heading -->
    <h1 class="wl-title fade-up delay-2">
      Wander the World,<br>
      <em>One Stay at a Time.</em>
    </h1>

    <!-- Author -->
    <p class="wl-author fade-up delay-3">
      Crafted with ❤️ by <span>Srishty Gupta</span>
    </p>

    <!-- Divider -->
    <div class="wl-divider fade-up delay-3"></div>

    <!-- Description -->
    <p class="wl-desc fade-up delay-4">
      <strong>WanderList</strong> is a full-stack Airbnb-inspired platform where travellers
      discover, list, and review unique accommodations around the globe.
      Built end-to-end with Node.js, Express, MongoDB, and EJS — turning
      a blank canvas into a live, production-ready web experience.
    </p>

    <!-- Primary CTAs -->
    <div class="d-flex justify-content-center gap-3 flex-wrap wl-btn-group fade-up delay-5">
      <a
        href="https://github.com/srish-web/MajorProject-WanderList-Airbnb-"
        target="_blank"
        rel="noopener noreferrer"
        class="wl-btn-primary"
      >
        <!-- GitHub icon (inline SVG, no CDN needed) -->
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.907-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.03-2.682-.103-.253-.447-1.27.097-2.646 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.376.202 2.393.1 2.646.64.698 1.028 1.59 1.028 2.682 0 3.842-2.337 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
        </svg>
        View Source Code
      </a>
      <a
        href="https://www.linkedin.com/in/srishty-gupta/"
        target="_blank"
        rel="noopener noreferrer"
        class="wl-btn-outline"
      >
        <!-- LinkedIn icon -->
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452H16.89v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a1.982 1.982 0 1 1 0-3.965 1.982 1.982 0 0 1 0 3.965zm1.71 13.019H3.625V9h3.422v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        About Me
      </a>
    </div>

    <!-- Stats row -->
    <div class="wl-stats fade-up delay-6">
      <div class="wl-stat">
        <span class="wl-stat-val">Full</span>
        <span class="wl-stat-label">Stack</span>
      </div>
      <div class="wl-stat">
        <span class="wl-stat-val">MEN</span>
        <span class="wl-stat-label">Stack (Mongo · Express · Node)</span>
      </div>
      <div class="wl-stat">
        <span class="wl-stat-val">Live</span>
        <span class="wl-stat-label">Project</span>
      </div>
    </div>

    <!-- Explore CTA -->
    <div class="mt-4 fade-up delay-7">
      <p class="mb-3" style="font-size:0.88rem; color:var(--text-secondary); font-weight:500; letter-spacing:0.04em; text-transform:uppercase;">
        Ready to explore?
      </p>
      <a href="/listings" class="wl-btn-explore">
        <!-- Arrow icon -->
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
        Explore WanderList
      </a>
    </div>

  </div><!-- /.wl-card -->
</section>
</body>